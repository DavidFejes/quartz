		},
		{
			"id": "cmx4XsXW",
			"type": "text",
			"x": 8006.784407478119,
			"y": 3750.013722765656,
			"width": 920.4192504882812,
			"height": 725,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c0UK",
			"roundness": null,
			"seed": 805527253,
			"version": 1748,
			"versionNonce": 2089470237,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778521970175,
			"link": null,
			"locked": false,
			"text": "keletkezés: 1823 jan. 22\nmegjelenés: 1829 - Aurora c. lap\nmegzenésiti: Erkel Ferenc 1844\ncím: műfajmegjelölő\nműfaj: himnusz, Istent dicsőítő költ.\nalcím: A magyar nép zivataros századaiból (visszahelyezi a szöveget a 16-17.sz-ba)\n\nAz E/2 istenre vonatkozik (felhozád, kebledben)\nszerkezete:\n    1,8vsz. verskeret (Isten megszólítása)\n    2-3vsz. múlt, dicsőség\n    4-6vsz. múlt, tragédiák\n    7vsz. jelen, tragikus\n\n1vsz.: megszólítás (Isten), jólétet kér, indok:magyarság túl sokat szenvedett (jövendőt)\n2-3vsz.: dicső múlt, honffoglalás, Mátyás (ezeket Isten segítette), magasztos hangvétel,\n        (Szent bérc, hős magzat...)\n4-6vsz.: indulatszóval kezdődik (Hajh-fájdalom), ok: saját bűnök, hibák, vihar = harag,\n          tatárjárás, törökök, belviszály, nemzeti tragédiák, erőteljes hanghatások,\n           mozgalmas (igék), expresszív = csonthalom, vérözön, lángtenger (romantika)\n7vsz.: idősíkváltás, jelen, ellentétek (vár, kőhalom), szenvedés, tragédiák, nyomasztó jövő\n        (kínzó rabság)\n8vsz.: keret, könyörgés, inverzió (szórendcsere) - ige kerül előre (Szánd), nemzet megmaradását\n        kéri\n\nverselés: szimultán \n    időmértékes: trochaikus (- U)\n    ütemhangsúlyos: 2 ütemű 6-os/7-es\n    rímképlet: keresztrím ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "keletkezés: 1823 jan. 22\nmegjelenés: 1829 - Aurora c. lap\nmegzenésiti: Erkel Ferenc 1844\ncím: műfajmegjelölő\nműfaj: himnusz, Istent dicsőítő költ.\nalcím: A magyar nép zivataros századaiból (visszahelyezi a szöveget a 16-17.sz-ba)\n\nAz E/2 istenre vonatkozik (felhozád, kebledben)\nszerkezete:\n    1,8vsz. verskeret (Isten megszólítása)\n    2-3vsz. múlt, dicsőség\n    4-6vsz. múlt, tragédiák\n    7vsz. jelen, tragikus\n\n1vsz.: megszólítás (Isten), jólétet kér, indok:magyarság túl sokat szenvedett (jövendőt)\n2-3vsz.: dicső múlt, honffoglalás, Mátyás (ezeket Isten segítette), magasztos hangvétel,\n        (Szent bérc, hős magzat...)\n4-6vsz.: indulatszóval kezdődik (Hajh-fájdalom), ok: saját bűnök, hibák, vihar = harag,\n          tatárjárás, törökök, belviszály, nemzeti tragédiák, erőteljes hanghatások,\n           mozgalmas (igék), expresszív = csonthalom, vérözön, lángtenger (romantika)\n7vsz.: idősíkváltás, jelen, ellentétek (vár, kőhalom), szenvedés, tragédiák, nyomasztó jövő\n        (kínzó rabság)\n8vsz.: keret, könyörgés, inverzió (szórendcsere) - ige kerül előre (Szánd), nemzet megmaradását\n        kéri\n\nverselés: szimultán \n    időmértékes: trochaikus (- U)\n    ütemhangsúlyos: 2 ütemű 6-os/7-es\n    rímképlet: keresztrím ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
