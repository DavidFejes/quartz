      "boundElements": [],
      "updated": 1774555979886,
      "link": null,
      "locked": false,
      "text": "keretes szerkezet (verszakok első és utolsó sora)\nverszakok első fele múlt másidok jelen -> ellentét\nidő múlása, halál gondolata\nhelyzetdal - E/1, de nem a szerző beszél",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "keretes szerkezet (verszakok első és utolsó sora)\nverszakok első fele múlt másidok jelen -> ellentét\nidő múlása, halál gondolata\nhelyzetdal - E/1, de nem a szerző beszél",
      "autoResize": true,
      "lineHeight": 1.25
    },
