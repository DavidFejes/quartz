      "version": 449,
      "versionNonce": 406516675,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774556183348,
      "link": null,
      "locked": false,
      "text": "1799 Moszkva, arisztokrata\nszülei keveset foglalkoztak velem gimnáziumban szerzett igazi műveltséget\nhivatalnok lett egyik verse miatt száműzték\n1826 visszatérthetett Moszkvába\n1831 megnősül\n1837 meghal párbajban",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1799 Moszkva, arisztokrata\nszülei keveset foglalkoztak velem gimnáziumban szerzett igazi műveltséget\nhivatalnok lett egyik verse miatt száműzték\n1826 visszatérthetett Moszkvába\n1831 megnősül\n1837 meghal párbajban",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zj76XcA9mleNY7BEjj_j-",
