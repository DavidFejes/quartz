    },
    {
      "id": "gxs_EcjND1xI06s54zQLh",
      "type": "text",
      "x": 2634.68497231974,
      "y": 1246.296368249138,
      "width": 746.439453125,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1147929748,
      "version": 1376,
      "versionNonce": 195895043,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774556183348,
      "link": null,
      "locked": false,
      "text": "1823- 30, többször átdolgozta\nműfaj: verses regény (cselekmény + érzelmek bemutatása)\nverselés: Anyigin-stófa\n    14 sor, jambikus (U-)\n    ababccddeffegg (rímképlet)\ncselekmény: Főszerplő Anyegin egy nemsi családból származik, napjait\n               a szórakozással tölti. Amikor vidéki rokona meghal\n               eldönti, hoyg vidékre költözik az örökölt birtokra.\n               Új tevékenységekbe kezd (gazdálkodik, olvas), de minddel\n               felhagy rövid idő után. Közönyösnek fásultnak érzi magát.\n               Ekkor találkozik a szomszédos Larin családdal és beleszert\n               az idősebbik lányuk Tatjana. Anyegin visszautastja és helyette\n               hugának Olgának udvarol akinek már vőlegénye van (igazából nem\n               is tetszik neki a csaj csak unja magát). Olga vőlegénye Lenszkij\n               párbajt kezdeményez és Anyegin megöli. Anyegin elutazik de jóval\n               később újra összefut a lánnyal. Ekkor rájön valójában mennyire\n               szereti a lányt de az ekkor már férjnél van. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1823- 30, többször átdolgozta\nműfaj: verses regény (cselekmény + érzelmek bemutatása)\nverselés: Anyigin-stófa\n    14 sor, jambikus (U-)\n    ababccddeffegg (rímképlet)\ncselekmény: Főszerplő Anyegin egy nemsi családból származik, napjait\n               a szórakozással tölti. Amikor vidéki rokona meghal\n               eldönti, hoyg vidékre költözik az örökölt birtokra.\n               Új tevékenységekbe kezd (gazdálkodik, olvas), de minddel\n               felhagy rövid idő után. Közönyösnek fásultnak érzi magát.\n               Ekkor találkozik a szomszédos Larin családdal és beleszert\n               az idősebbik lányuk Tatjana. Anyegin visszautastja és helyette\n               hugának Olgának udvarol akinek már vőlegénye van (igazából nem\n               is tetszik neki a csaj csak unja magát). Olga vőlegénye Lenszkij\n               párbajt kezdeményez és Anyegin megöli. Anyegin elutazik de jóval\n               később újra összefut a lánnyal. Ekkor rájön valójában mennyire\n               szereti a lányt de az ekkor már férjnél van. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
