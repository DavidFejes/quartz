      "type": "text",
      "x": 2559.8799288481528,
      "y": 2621.0326296682956,
      "width": 798.01953125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
