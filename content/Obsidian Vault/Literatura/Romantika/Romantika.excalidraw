    {
      "id": "O6-TzkMv76rSYHHlsVu4S",
      "type": "text",
      "x": 448.3984462187991,
      "y": 1117.923670582485,
      "width": 693.239501953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1901376020,
      "version": 362,
      "versionNonce": 272858413,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774555983903,
      "link": null,
      "locked": false,
      "text": "12. sz. keresztesháborúk idején\ncím = főszereplő (nemes, családjával konfliktusban)\n\nelkiséri az uralkodót a Szent Földre (Oroszlánszívű Richárdot)\nvisszatérésük után Ivanhoe abban segíti a királyt, hogy visszaszerezze\na trónt, és a szegényeken akar segíteni\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "12. sz. keresztesháborúk idején\ncím = főszereplő (nemes, családjával konfliktusban)\n\nelkiséri az uralkodót a Szent Földre (Oroszlánszívű Richárdot)\nvisszatérésük után Ivanhoe abban segíti a királyt, hogy visszaszerezze\na trónt, és a szegényeken akar segíteni\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
