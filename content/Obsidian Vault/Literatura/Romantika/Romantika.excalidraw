      "isDeleted": false,
      "boundElements": [],
      "updated": 1774555979886,
      "link": null,
      "locked": false,
      "text": "egy falusi történetet ír le, két személy találkozását,\nhumoros, irónikus, megjelenik a halál, boldog szerelem",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
