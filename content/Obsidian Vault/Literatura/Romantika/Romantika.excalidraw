      "isDeleted": false,
      "boundElements": [],
      "updated": 1774555983903,
      "link": null,
      "locked": false,
      "text": "korai romantikus\nskót nemes, történelemmel foglalkozott, történelmi regényeket írt\n\n-> történelmi múltban játszódik, kitalált főszereplő, valós mellékszereplők\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "korai romantikus\nskót nemes, történelemmel foglalkozott, történelmi regényeket írt\n\n-> történelmi múltban játszódik, kitalált főszereplő, valós mellékszereplők\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PcYfo4Snequsb0LFFVAwA",
      "type": "text",
      "x": 664.6671848563069,
      "y": 1016.2063089056506,
      "width": 237.55029349200063,
      "height": 77.2069814472875,
