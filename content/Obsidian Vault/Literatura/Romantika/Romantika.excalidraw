      "boundElements": [],
      "updated": 1774556162845,
      "link": null,
      "locked": false,
      "text": "(1814)\n(műfaj: regény)\ntörténet: Anselnus (diák) találkozik Serpentinával (kigyó alakban)\n            célja elnyerni a kezét, ehhez próbákat kell kiállnia\n            végén kivirágzik a liliom a cserépben, nem térnek vissza\n            a valóságba (Atlantiszra költöznek) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(1814)\n(műfaj: regény)\ntörténet: Anselnus (diák) találkozik Serpentinával (kigyó alakban)\n            célja elnyerni a kezét, ehhez próbákat kell kiállnia\n            végén kivirágzik a liliom a cserépben, nem térnek vissza\n            a valóságba (Atlantiszra költöznek) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
