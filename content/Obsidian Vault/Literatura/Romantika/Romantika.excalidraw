      "versionNonce": 2088230797,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774555991920,
      "link": null,
      "locked": false,
      "text": "Amerikai\n(1809-49)\nművei témája a fantasztikum (krimi, horror)\nars poetica: nem csak a téma, hanme a megfogalmazás is hat az\n               olvasóra, ezáltal kiszámítható a hatása az emberre",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Amerikai\n(1809-49)\nművei témája a fantasztikum (krimi, horror)\nars poetica: nem csak a téma, hanme a megfogalmazás is hat az\n               olvasóra, ezáltal kiszámítható a hatása az emberre",
      "autoResize": true,
      "lineHeight": 1.25
    },
