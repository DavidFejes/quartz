		{
			"id": "7DkbPvzv",
			"type": "text",
			"x": 2605.4584297513447,
			"y": 2092.627642488384,
			"width": 696.1595458984375,
			"height": 450,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c1jj",
			"roundness": null,
			"seed": 922611285,
			"version": 1226,
			"versionNonce": 894397844,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772032291958,
			"link": null,
			"locked": false,
			"text": "műfaj: elégia\nverselés: időértékes (aszklepipádeszi)\ncím: Kazinczy átírta, eredeti \"ősz\", szorongást és feszengést \n     kelt, \"közelítő\" jelző szintén\nszerkezet:\n    1-3vsz.: tájleírás, tagadás -> negatív festés (veszteséget\n              fejezi ki, hiányérzet), klasszicista, antik utalások, \n              kijelentő mondatok\n\n    4vsz.: elmúlás, E/3, felkiáltó mondat, indulatszó\n            zaklatottság, gyorsan telik az idő, rövid az élet,\n            mindenkire vonatkozik (általánosít) \n\n    5-6vsz.: halál, E/1, személyes vallomás, metafora (\"koszorúm bimbója\"\n               =tavasz, fiatalság), nem nyugszik bele a halálba, még túl\n               fiatal, ellentét (ember - természet), egyszeri élet - \n               újrakezdés, újjászületés, szerelem (ez sem állítja meg\n               a halált)",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "műfaj: elégia\nverselés: időértékes (aszklepipádeszi)\ncím: Kazinczy átírta, eredeti \"ősz\", szorongást és feszengést \n     kelt, \"közelítő\" jelző szintén\nszerkezet:\n    1-3vsz.: tájleírás, tagadás -> negatív festés (veszteséget\n              fejezi ki, hiányérzet), klasszicista, antik utalások, \n              kijelentő mondatok\n\n    4vsz.: elmúlás, E/3, felkiáltó mondat, indulatszó\n            zaklatottság, gyorsan telik az idő, rövid az élet,\n            mindenkire vonatkozik (általánosít) \n\n    5-6vsz.: halál, E/1, személyes vallomás, metafora (\"koszorúm bimbója\"\n               =tavasz, fiatalság), nem nyugszik bele a halálba, még túl\n               fiatal, ellentét (ember - természet), egyszeri élet - \n               újrakezdés, újjászületés, szerelem (ez sem állítja meg\n               a halált)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
