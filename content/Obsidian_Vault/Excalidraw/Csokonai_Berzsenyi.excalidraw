			"isDeleted": false,
			"boundElements": [],
			"updated": 1772032291958,
			"link": null,
			"locked": false,
			"text": "műfaj: elégiko-óda\nszentimentalista és rokokó jellemzők\n\nrokokó versforma (rövid sorok -> gyors)\n    könnyedséget sugall\n\nszerkezet: Remény megszólítása, elkeseredettség\n    1.vsz.: Remény jellemzése, becsapta a Remény, \n            felkiáltó és kérdő mondatok\n\n    2.vsz.: múlt, boldogság, évszak toposz (tavasz), virágmotívum,\n             sok ige, hanghatás, szerelem\n\n    3.vsz.: évszaktoposz (tél), szomorúság, indulatszó fájdalom (jaj),\n             megismétli a 2. vsz.-ot (de negatív kifejezésekkel),\n             gyöngykoszorú = költészet\n\n    4.vsz.: ismét megszólítja a Reményt, lemond az életre, \n            napszak toposz (éj), halál, elbúcsúzik a költészettől\n            és szerelmétől, tő és hiányos mondatok \n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "műfaj: elégiko-óda\nszentimentalista és rokokó jellemzők\n\nrokokó versforma (rövid sorok -> gyors)\n    könnyedséget sugall\n\nszerkezet: Remény megszólítása, elkeseredettség\n    1.vsz.: Remény jellemzése, becsapta a Remény, \n            felkiáltó és kérdő mondatok\n\n    2.vsz.: múlt, boldogság, évszak toposz (tavasz), virágmotívum,\n             sok ige, hanghatás, szerelem\n\n    3.vsz.: évszaktoposz (tél), szomorúság, indulatszó fájdalom (jaj),\n             megismétli a 2. vsz.-ot (de negatív kifejezésekkel),\n             gyöngykoszorú = költészet\n\n    4.vsz.: ismét megszólítja a Reményt, lemond az életre, \n            napszak toposz (éj), halál, elbúcsúzik a költészettől\n            és szerelmétől, tő és hiányos mondatok \n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
