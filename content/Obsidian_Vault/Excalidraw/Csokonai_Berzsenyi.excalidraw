			"version": 837,
			"versionNonce": 1009206036,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772032291958,
			"link": null,
			"locked": false,
			"text": "egy korábbi vers átdolgozása\nműfaj: dal\n\nszimultán verselés: időmértékes és ütemhangsúlyos\n    ütemhangsúlyos: 2 ütemű 8-as/7-es\n    időmértékes: UU- -| UU- -\n                    UU- -| UU-\n    \n(ionicus a minore: UU - -, anapesztosz: UU -)\n\nszerkezet:\n    1.vsz.: szerelem, metafora szerelem = tűz (toposz),\n           túlzás, dicsőíti szerelmét\n\n    2.vsz.: megjelenik a szeretett személy (nem ad teljes jellemzést)\n            tűz = tekintet (megváltozott), boldogság, túlzás\n\n    3.vsz.: visszakapcsolódik a címhez, klasszicizmus (ambrózia),\n             magasztos kifejezések (ünnepes, angyali), boldog \n             szerelem",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "egy korábbi vers átdolgozása\nműfaj: dal\n\nszimultán verselés: időmértékes és ütemhangsúlyos\n    ütemhangsúlyos: 2 ütemű 8-as/7-es\n    időmértékes: UU- -| UU- -\n                    UU- -| UU-\n    \n(ionicus a minore: UU - -, anapesztosz: UU -)\n\nszerkezet:\n    1.vsz.: szerelem, metafora szerelem = tűz (toposz),\n           túlzás, dicsőíti szerelmét\n\n    2.vsz.: megjelenik a szeretett személy (nem ad teljes jellemzést)\n            tűz = tekintet (megváltozott), boldogság, túlzás\n\n    3.vsz.: visszakapcsolódik a címhez, klasszicizmus (ambrózia),\n             magasztos kifejezések (ünnepes, angyali), boldog \n             szerelem",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
