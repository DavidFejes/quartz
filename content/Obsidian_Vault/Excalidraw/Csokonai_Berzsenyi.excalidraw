		},
		{
			"id": "rQZmKerW",
			"type": "text",
			"x": 1953.4378298003664,
			"y": 1825.936083932942,
			"width": 442.0396423339844,
			"height": 200,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c1jZ",
			"roundness": null,
			"seed": 1752442811,
			"version": 873,
			"versionNonce": 584727060,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772032291958,
			"link": null,
			"locked": false,
			"text": "I. hazafias: nemzet sorsát vizsgálja\n               szembeállítja egymással a dícső\n               múltat és a romlott jelent \n               erkölcsi hanyatlás\n               nemzethalál (jövőkép)\n               idő-és értékszembesítő versek\n\nII. költészeti: ars poetica, horatiusi filozófia",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "I. hazafias: nemzet sorsát vizsgálja\n               szembeállítja egymással a dícső\n               múltat és a romlott jelent \n               erkölcsi hanyatlás\n               nemzethalál (jövőkép)\n               idő-és értékszembesítő versek\n\nII. költészeti: ars poetica, horatiusi filozófia",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "QEWMAHAA",
			"type": "text",
			"x": 1232.1896375666079,
			"y": 1753.070148875337,
			"width": 515.076171875,
			"height": 68.32137027403269,
