		{
			"id": "LGg9hwxM",
			"type": "text",
			"x": 725.6060472511597,
			"y": -130.34961646517453,
			"width": 688.9595947265625,
			"height": 550,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c1mZ",
			"roundness": null,
			"seed": 516404534,
			"version": 1388,
			"versionNonce": 1288393108,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772032291958,
			"link": null,
			"locked": false,
			"text": "Dorottya vagyis a dámák diadalma Fársángon\nműfaj: komikus eposz (végeposz)\n        verses hosszú, nevetséges, érdektelen történetet \n        tesz érdekesség\nkeletkezés: 1799\ntéma: farsangi bál leírása\ncselekmény: Főszereplő Dorottya (65), farsangi bálban akar férjet\n               találni. Mikor kiderül, hogy rövidebb lesz az esemény\n               vezetésével fellázadnak (hajadonak) és követelik \n               meghosszabbítását. Megjelenik Vénusz (gythere) istennő, \n               megfiatalítja őt, meghosszabbítja, így férjet találnak.\n               (hajadonak is=csunyak)\nA korabeli magyar nemesség felszínességét és kultúrálatanságát\nkritizálja\neposzi kellékek: -témamegjelölés, (első 15sor) drámák harca\n                    -segélykérés, Múzsa helyett borhoz fohászkodik\n                    -seregszemle, bemutatja a bál résztvevőit\n                    -csodás elem, (deus ex machina) Eris mérgezett fánkja\n                                    Gythere (Vénusz) megjelenése, békítés\nstílus: rokokó\nhangvétel: gúnyos, irónikus\nverselés: ütemhangsúlyos",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Dorottya vagyis a dámák diadalma Fársángon\nműfaj: komikus eposz (végeposz)\n        verses hosszú, nevetséges, érdektelen történetet \n        tesz érdekesség\nkeletkezés: 1799\ntéma: farsangi bál leírása\ncselekmény: Főszereplő Dorottya (65), farsangi bálban akar férjet\n               találni. Mikor kiderül, hogy rövidebb lesz az esemény\n               vezetésével fellázadnak (hajadonak) és követelik \n               meghosszabbítását. Megjelenik Vénusz (gythere) istennő, \n               megfiatalítja őt, meghosszabbítja, így férjet találnak.\n               (hajadonak is=csunyak)\nA korabeli magyar nemesség felszínességét és kultúrálatanságát\nkritizálja\neposzi kellékek: -témamegjelölés, (első 15sor) drámák harca\n                    -segélykérés, Múzsa helyett borhoz fohászkodik\n                    -seregszemle, bemutatja a bál résztvevőit\n                    -csodás elem, (deus ex machina) Eris mérgezett fánkja\n                                    Gythere (Vénusz) megjelenése, békítés\nstílus: rokokó\nhangvétel: gúnyos, irónikus\nverselés: ütemhangsúlyos",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
