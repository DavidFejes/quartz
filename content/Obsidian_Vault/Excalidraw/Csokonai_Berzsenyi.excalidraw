			"version": 990,
			"versionNonce": 2042974252,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772032291958,
			"link": null,
			"locked": false,
			"text": "műfaja: elégia (nem episztola)\nrímelés: ütemhangsúlyos\néletkép, hétköznapi jelenet\nszerkezet:\n    1vsz.: magán \n    2vsz.: életkép, ősz, este, elmúlás, halál\n    3vsz.: költészet (\"képzelet égi álma\")\n    4vsz.: szomorú, elégikus (hanghatással éri el), eltűnt örömök\n            szomorú jelen\n    5vsz.: 5 soros (ha megváltozik a szabályos versforma, nyugtalanságot\n            és zaklatottságot kelt), lelkileg megöregedett, nem volt\n            boldog az élete (\"élet vidám álorcája\"), két vigasztalója szerelem\n            és költészet (\"hamvadó szikra; szomorgó nóta\"), \n            inkább romantikus mint klasszicista",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "műfaja: elégia (nem episztola)\nrímelés: ütemhangsúlyos\néletkép, hétköznapi jelenet\nszerkezet:\n    1vsz.: magán \n    2vsz.: életkép, ősz, este, elmúlás, halál\n    3vsz.: költészet (\"képzelet égi álma\")\n    4vsz.: szomorú, elégikus (hanghatással éri el), eltűnt örömök\n            szomorú jelen\n    5vsz.: 5 soros (ha megváltozik a szabályos versforma, nyugtalanságot\n            és zaklatottságot kelt), lelkileg megöregedett, nem volt\n            boldog az élete (\"élet vidám álorcája\"), két vigasztalója szerelem\n            és költészet (\"hamvadó szikra; szomorgó nóta\"), \n            inkább romantikus mint klasszicista",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
